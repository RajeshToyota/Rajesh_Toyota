{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "next/link": ["./src/compat/link.tsx"],
      "next/navigation": ["./src/compat/navigation.ts"],
      "next/cache": ["./src/compat/cache.ts"],
      "server-only": ["./src/compat/empty.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
